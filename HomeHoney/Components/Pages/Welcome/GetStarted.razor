@page "/welcome/get-started"
@using HomeHoney.Services.Navigation
@inject HomeHoney.Services.Preferences.UserPreferenceService UserPreferenceService
@inject NavigationManager NavigationManager

<section class="content-page">
    <PageHeader Eyebrow="开始使用"
                Title="推荐从这三步开始"
                Description="完成首次引导后，下次打开应用会直接进入首页；后续仍可从设置中主动回看。"
                BackHref="@AppRoutes.GetParentRoute(AppRoutes.WelcomeGetStarted)"
                BackText="返回上一页">
    </PageHeader>

    <ol class="step-list">
        <li>先进入 <strong>资料</strong> 模块，把保险和说明书整理成可搜索的记录。</li>
        <li>把家人会频繁查看的短事项放到 <strong>冰箱贴</strong>。</li>
        <li>去 <strong>设置</strong> 里调整主题与提醒，让首页更符合你的习惯。</li>
    </ol>

    <div class="hero-card-group">
        <article class="hero-card">
            <h2>后续还能做什么？</h2>
            <p>你可以随时在设置中再次查看引导，也可以通过首页快捷入口直接开始录入资料。</p>
        </article>
    </div>

    <div class="page-actions">
        <button class="button-primary" @onclick="CompleteAsync">@PrimaryActionText</button>
        <a class="button-secondary" href="@AppRoutes.GetParentRoute(AppRoutes.WelcomeGetStarted)">返回上一页</a>
    </div>
</section>

@code {
    private string PrimaryActionText => UserPreferenceService.IsOnboardingCompleted ? "结束回看，进入首页" : "完成引导，进入首页";

    private async Task CompleteAsync()
    {
        await UserPreferenceService.CompleteOnboardingAsync();
        NavigationManager.NavigateTo(AppRoutes.Home, forceLoad: false);
    }
}
