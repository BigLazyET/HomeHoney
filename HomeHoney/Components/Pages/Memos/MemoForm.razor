@page "/memos/new"
@page "/memos/{Id:guid}/edit"
@inject HomeHoney.Services.Collaboration.FamilyCollaborationService FamilyCollaborationService
@inject NavigationManager NavigationManager
@using HomeHoney.Models

<section class="content-page form-page">
    <div class="section-heading">
        <div>
            <span class="page-eyebrow">备忘录编辑</span>
            <h1>@(IsEditMode ? "编辑备忘录" : "新增备忘录")</h1>
            <p>适合记录较长内容、长期计划和需要归档的家庭规则。</p>
        </div>
    </div>

    <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
        <div class="form-grid">
            <label>
                <span>标题</span>
                <InputText @bind-Value="_model.Title" />
            </label>
            <label>
                <span>分类</span>
                <InputSelect @bind-Value="_model.MemoCategory">
                    @foreach (var value in Enum.GetValues<MemoCategory>())
                    {
                        <option value="@value">@value</option>
                    }
                </InputSelect>
            </label>
            <label>
                <span>重要级别</span>
                <InputSelect @bind-Value="_model.Importance">
                    @foreach (var value in Enum.GetValues<MemoImportance>())
                    {
                        <option value="@value">@value</option>
                    }
                </InputSelect>
            </label>
            <label>
                <span>状态</span>
                <InputSelect @bind-Value="_model.Status">
                    @foreach (var value in Enum.GetValues<MemoStatus>())
                    {
                        <option value="@value">@value</option>
                    }
                </InputSelect>
            </label>
            <label>
                <span>到期时间</span>
                <InputDate @bind-Value="_dueDate" />
            </label>
            <label class="form-grid-span-2">
                <span>内容</span>
                <InputTextArea @bind-Value="_model.Content" />
            </label>
        </div>

        <div class="page-actions">
            <a class="button-secondary" href="/memos">取消</a>
            <button class="button-primary" type="submit">保存</button>
        </div>
    </EditForm>
</section>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private Memo _model = new();
    private DateTime _dueDate = DateTime.Today.AddDays(7);

    private bool IsEditMode => Id.HasValue;

    protected override async Task OnParametersSetAsync()
    {
        if (Id is Guid id)
        {
            _model = await FamilyCollaborationService.GetMemoAsync(id) ?? FamilyCollaborationService.CreateMemoTemplate();
        }
        else
        {
            _model = FamilyCollaborationService.CreateMemoTemplate();
        }

        _dueDate = _model.DueAt ?? DateTime.Today.AddDays(7);
    }

    private async Task HandleSubmitAsync()
    {
        _model.DueAt = _dueDate;
        await FamilyCollaborationService.SaveMemoAsync(_model);
        NavigationManager.NavigateTo($"/memos/{_model.Id}");
    }
}
