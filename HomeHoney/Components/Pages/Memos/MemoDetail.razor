@page "/memos/{Id:guid}"
@inject HomeHoney.Services.Collaboration.FamilyCollaborationService FamilyCollaborationService
@using HomeHoney.Models
@using HomeHoney.Components.Shared

@if (_memo is null)
{
    <EmptyState Icon="📝" Title="未找到备忘录" Description="该备忘录可能已被归档或移除，请返回列表重新选择。" />
}
else
{
    <section class="content-page detail-page">
        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <StatusBanner Message="@_statusMessage" IsError="false" />
        }

        <div class="section-heading">
            <div>
                <span class="page-eyebrow">家庭备忘录</span>
                <h1>@PresentationFallbacks.TextOrFallback(_memo.Title, "未命名备忘录")</h1>
                <p>@PresentationFallbacks.TextOrFallback(_memo.Content, "这条备忘录暂时还没有填写详细内容。")</p>
            </div>
            <div class="page-actions-inline">
                <a class="button-secondary" href="/memos">返回列表</a>
                <a class="button-primary" href="@($"/memos/{_memo.Id}/edit")">编辑备忘</a>
            </div>
        </div>

        <div class="detail-grid">
            <article class="detail-card">
                <h2>状态信息</h2>
                <ul>
                    <li>分类：@GetCategoryLabel(_memo.MemoCategory)</li>
                    <li>重要级别：@GetImportanceLabel(_memo.Importance)</li>
                    <li>状态：@GetStatusLabel(_memo.Status)</li>
                    <li>到期时间：@PresentationFallbacks.DateTimeOrFallback(_memo.DueAt)</li>
                </ul>
            </article>
            <article class="detail-card">
                <h2>后续动作</h2>
                <ul>
                    <li>可在提醒中心集中查看</li>
                    <li>可被首页摘要区优先展示</li>
                    <li>适合沉淀长期家庭事项</li>
                </ul>
            </article>
        </div>
    </section>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Memo? _memo;
    private string? _statusMessage;

    protected override async Task OnParametersSetAsync()
    {
        _memo = await FamilyCollaborationService.GetMemoAsync(Id);
        _statusMessage = FamilyCollaborationService.LastErrorMessage;
    }

    private static string GetCategoryLabel(MemoCategory category) => category switch
    {
        MemoCategory.FamilyRule => "家庭规则",
        MemoCategory.LongTermPlan => "长期计划",
        MemoCategory.ShoppingPlan => "采购计划",
        MemoCategory.Medical => "医疗事项",
        MemoCategory.Education => "教育安排",
        _ => "其他",
    };

    private static string GetImportanceLabel(MemoImportance importance) => importance switch
    {
        MemoImportance.Critical => "高优先级",
        MemoImportance.Important => "重要",
        _ => "普通",
    };

    private static string GetStatusLabel(MemoStatus status) => status switch
    {
        MemoStatus.InProgress => "进行中",
        MemoStatus.Completed => "已完成",
        _ => "已归档",
    };
}
