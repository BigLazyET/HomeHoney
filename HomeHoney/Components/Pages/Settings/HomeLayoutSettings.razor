@page "/settings/home-layout"
@inject HomeHoney.Services.Preferences.UserPreferenceService UserPreferenceService
@using HomeHoney.Models
@using HomeHoney.Components.Shared

<section class="content-page">
    <PageHeader Eyebrow="首页布局"
                Title="首页模块顺序与可见性"
                Description="决定首页先展示哪些摘要模块，优先把你最常查看的内容放在前面。"
                BackHref="@AppRoutes.GetParentRoute(AppRoutes.SettingsHomeLayout)"
                BackText="返回设置">
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <StatusBanner Message="@_statusMessage" IsError="@_isError" />
    }

    <div class="choice-list">
        @foreach (var moduleType in Preferences.HomeModuleOrder)
        {
            var isHidden = Preferences.HiddenHomeModules.Contains(moduleType);
            <div class="choice-item is-static">
                <div>
                    <strong>@GetLabel(moduleType)</strong>
                    <span>@(isHidden ? "当前已隐藏" : "当前显示")</span>
                </div>
                <div class="choice-actions">
                    <button class="button-secondary small" @onclick="() => MoveUpAsync(moduleType)">上移</button>
                    <button class="button-secondary small" @onclick="() => MoveDownAsync(moduleType)">下移</button>
                    <button class="button-primary small" @onclick="() => ToggleVisibilityAsync(moduleType, isHidden)">@((isHidden ? "显示" : "隐藏"))</button>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private UserPreference Preferences => UserPreferenceService.GetPreferences();

    private string? _statusMessage;
    private bool _isError;

    private async Task MoveUpAsync(HomeModuleType moduleType)
    {
        await UserPreferenceService.MoveModuleUpAsync(moduleType);
        UpdateStatus("首页模块顺序已更新并同步到后端。");
    }

    private async Task MoveDownAsync(HomeModuleType moduleType)
    {
        await UserPreferenceService.MoveModuleDownAsync(moduleType);
        UpdateStatus("首页模块顺序已更新并同步到后端。");
    }

    private async Task ToggleVisibilityAsync(HomeModuleType moduleType, bool isHidden)
    {
        await UserPreferenceService.SetModuleVisibilityAsync(moduleType, isVisible: isHidden);
        UpdateStatus("首页模块可见性已更新并同步到后端。");
    }

    private void UpdateStatus(string successMessage)
    {
        _isError = !string.IsNullOrWhiteSpace(UserPreferenceService.LastRemoteSyncErrorMessage);
        _statusMessage = UserPreferenceService.LastRemoteSyncErrorMessage ?? successMessage;
    }

    private static string GetLabel(HomeModuleType type) => type switch
    {
        HomeModuleType.QuickActions => "快捷操作",
        HomeModuleType.UpcomingReminders => "未来 30 天需要关注的事项",
        HomeModuleType.RecentDocuments => "最近资料",
        HomeModuleType.FamilyMessages => "家庭留言摘要",
        _ => "推荐下一步",
    };
}
