@page "/settings/privacy"
@inject HomeHoney.Services.Preferences.UserPreferenceService UserPreferenceService
@using HomeHoney.Models

<section class="content-page">
    <PageHeader Eyebrow="隐私与安全"
                Title="敏感信息显示策略"
                Description="在家庭共用设备场景下，你可以控制详情页展示的敏感程度，并决定是否重新浏览欢迎帮助流程。"
                BackHref="@AppRoutes.GetParentRoute(AppRoutes.SettingsPrivacy)"
                BackText="返回设置">
        <a class="button-secondary" href="@AppRoutes.WelcomePreview">再次查看引导</a>
    </PageHeader>

    <div class="choice-list">
        @foreach (var mode in Enum.GetValues<PrivacyMode>())
        {
            <button class="choice-item @(Preferences.PrivacyMode == mode ? "is-active" : string.Empty)" @onclick="() => SetPrivacyAsync(mode)">
                <strong>@GetLabel(mode)</strong>
                <span>@GetDescription(mode)</span>
            </button>
        }
    </div>

</section>

@code {
    private UserPreference Preferences => UserPreferenceService.GetPreferences();

    private Task SetPrivacyAsync(PrivacyMode mode) => UserPreferenceService.SetPrivacyModeAsync(mode);

    private static string GetLabel(PrivacyMode mode) => mode switch
    {
        PrivacyMode.Standard => "普通显示",
        PrivacyMode.MaskSensitive => "部分遮挡",
        _ => "进入详情前验证",
    };

    private static string GetDescription(PrivacyMode mode) => mode switch
    {
        PrivacyMode.Standard => "在列表和详情中完整显示摘要字段",
        PrivacyMode.MaskSensitive => "在摘要中弱化敏感字段，适合家庭共用设备",
        _ => "进入详情页前再次确认，适合更高隐私需求",
    };
}
