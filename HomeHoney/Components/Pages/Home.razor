@page "/"
@inject ReminderCenterService ReminderCenterService
@inject UserPreferenceService UserPreferenceService
@using HomeHoney.Components.Shared
@using System.Diagnostics

<section class="content-page home-dashboard">
    <div class="section-heading">
        <div>
            <span class="page-eyebrow">首页</span>
            <h1>HomeHoney</h1>
            <p class="home-subtitle">家庭说明书、保险、冰箱贴和备忘录，都从这里快速进入。</p>
        </div>
    </div>

    @foreach (var moduleType in UserPreferenceService.GetPreferences().HomeModuleOrder)
    {
        if (IsVisible(moduleType))
        {
            switch (moduleType)
            {
                case HomeModuleType.QuickActions:
                    <section class="home-section">
                        <div class="section-title-row">
                            <h2>快捷操作</h2>
                            <a href="@AppRoutes.SettingsHomeLayout">调整顺序</a>
                        </div>
                        <QuickActionGrid Actions="@_quickActions" />
                    </section>
                    break;
                case HomeModuleType.UpcomingReminders:
                    <section class="home-section">
                        <div class="section-title-row">
                            <h2>未来 30 天需要关注的事项</h2>
                            <a href="@AppRoutes.Search">进入搜索</a>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_reminderStatusMessage))
                        {
                            <StatusBanner Message="@_reminderStatusMessage" IsError="false" />
                        }

                        @if (_upcomingReminders.Count == 0)
                        {
                            <EmptyState Icon="⏰" Title="近期没有紧急事项" Description="录入保单、说明书和家庭待办后，这里会自动显示未来 30 天的重要提醒。" />
                        }
                        else
                        {
                            <div class="card-stack">
                                @foreach (var item in _upcomingReminders.Take(4))
                                {
                                    <ReminderCard Title="@item.Title"
                                                  Summary="@item.Summary"
                                                  SourceLabel="@item.SourceType.ToString()"
                                                  PriorityLabel="@GetPriorityLabel(item.Priority)"
                                                  PriorityClass="@item.Priority.ToString().ToLowerInvariant()"
                                                  DueAt="@item.DueAt"
                                                  Href="@item.Href" />
                                }
                            </div>
                        }
                    </section>
                    break;
            }
        }
    }
</section>

@code {
    private IReadOnlyList<ReminderItem> _upcomingReminders = [];
    private string? _reminderStatusMessage;

    private readonly IReadOnlyList<QuickActionItem> _quickActions =
    [
        new() { Title = "新增保险", Description = "录入保单和到期日期", Icon = "🛡️", Href = AppRoutes.InsuranceNew },
        new() { Title = "新增说明书", Description = "补充设备与保修信息", Icon = "📘", Href = AppRoutes.ManualNew },
        new() { Title = "写冰箱贴", Description = "记录购物或临时提醒", Icon = "🧲", Href = AppRoutes.FridgeNoteNew },
        new() { Title = "写备忘录", Description = "保存长期事项", Icon = "📝", Href = AppRoutes.MemoNew },
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadRemindersAsync();
    }

    private async Task LoadRemindersAsync()
    {
        try
        {
            _upcomingReminders = await ReminderCenterService.GetUpcomingAsync();
            _reminderStatusMessage = ReminderCenterService.LastErrorMessage;
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Home.LoadRemindersAsync Error: {ex}");
            _upcomingReminders = [];
            _reminderStatusMessage = "提醒摘要暂时无法加载，请稍后重试。";
        }
    }

    private bool IsVisible(HomeModuleType moduleType) => !UserPreferenceService.GetPreferences().HiddenHomeModules.Contains(moduleType);

    private static string GetPriorityLabel(ReminderPriority priority) => priority switch
    {
        ReminderPriority.High => "高优先级",
        ReminderPriority.Medium => "中优先级",
        _ => "低优先级",
    };
}
