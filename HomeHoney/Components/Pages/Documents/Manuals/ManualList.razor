@page "/documents/manuals"
@inject HomeHoney.Services.Documents.DocumentCatalogService DocumentCatalogService
@using HomeHoney.Models
@using HomeHoney.Components.Shared

<section class="content-page">
    <PageHeader Eyebrow="说明书"
                Title="说明书列表"
                Description="按空间、设备或品牌整理说明书，临时查找时更快定位到正确资料。"
                BackHref="@AppRoutes.Documents"
                BackText="返回资料模块">
        <a class="button-primary" href="@AppRoutes.ManualNew">新增说明书</a>
    </PageHeader>

    <FilterBar SearchPlaceholder="搜索设备名称、品牌、标签"
               Filters="_filters" />

    @if (!string.IsNullOrWhiteSpace(_state.Message))
    {
        <StatusBanner Title="@(_state.Status == CollectionViewStatus.Error ? "资料读取失败" : "资料同步提醒")"
                      Message="@_state.Message"
                      IsError="@(_state.Status == CollectionViewStatus.Error)"
                      IsLoading="@(_state.Status == CollectionViewStatus.Retrying)"
                      ActionText="@(_state.CanRetry ? "手动重试" : null)"
                      OnAction="ReloadAsync" />
    }

    @if (_state.Status == CollectionViewStatus.Loading || _state.Status == CollectionViewStatus.Retrying)
    {
        <EmptyState Icon="📘" Title="正在加载说明书资料" Description="请稍候，系统正在尝试读取最新说明书信息。" />
    }
    else if (_state.Items.Count == 0 && _state.Status != CollectionViewStatus.Error)
    {
        <EmptyState Icon="📘" Title="还没有说明书资料" Description="录入设备说明书后，可以按空间和品牌快速定位。" ActionText="新增说明书" ActionHref="@AppRoutes.ManualNew" />
    }
    else
    {
        <div class="card-stack">
            @foreach (var record in _state.Items)
            {
                <DocumentCard Title="@record.DeviceName"
                              Category="说明书"
                              Subtitle="@($"{record.Brand} · {record.Model}")"
                              Description="@record.Summary"
                              Badge="@record.ManualCategory.ToString()"
                              Href="@AppRoutes.ManualDetail(record.Id)"
                              Tags="@record.Tags"
                              MetaItems="@GetMeta(record)" />
            }
        </div>
    }
</section>

@code {
    private RetryableCollectionState<ManualRecord> _state = RetryableCollectionState<ManualRecord>.CreateLoading();
    private readonly IReadOnlyList<string> _filters = ["全部", "按空间", "按品牌", "保修中", "即将到期"];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private Task ReloadAsync() => LoadAsync(isRetry: true);

    private async Task LoadAsync(bool isRetry = false)
    {
        _state = isRetry
            ? RetryableCollectionState<ManualRecord>.CreateRetrying(_state.Items, _state.Message)
            : RetryableCollectionState<ManualRecord>.CreateLoading(_state.Items);

        var records = await DocumentCatalogService.GetManualRecordsAsync();
        var message = DocumentCatalogService.LastErrorMessage;
        if (!string.IsNullOrWhiteSpace(message))
        {
            _state = RetryableCollectionState<ManualRecord>.CreateError(message, records, _state.LastSuccessAt);
            return;
        }

        _state = records.Count == 0
            ? RetryableCollectionState<ManualRecord>.CreateEmpty()
            : RetryableCollectionState<ManualRecord>.CreateReady(records);
    }

    private static IReadOnlyList<string> GetMeta(ManualRecord record) =>
    [
        $"型号：{record.Model}",
        $"保修截止：{record.WarrantyExpiryDate:yyyy-MM-dd}",
        $"附件：{record.AttachmentCount} 份",
    ];
}
