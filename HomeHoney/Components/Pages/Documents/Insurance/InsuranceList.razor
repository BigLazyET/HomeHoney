@page "/documents/insurance"
@inject HomeHoney.Services.Documents.DocumentCatalogService DocumentCatalogService
@using HomeHoney.Models
@using HomeHoney.Components.Shared

<section class="content-page">
    <div class="section-heading">
        <div>
            <span class="page-eyebrow">保险</span>
            <h1>保险列表</h1>
            <p>按状态、家庭成员和到期时间快速查看家庭保障现状。</p>
        </div>
        <a class="button-primary" href="/documents/insurance/new">新增保险</a>
    </div>

    <FilterBar SearchPlaceholder="搜索保单名称、保障摘要、标签"
               Filters="_filters" />

    @if (_records.Count == 0)
    {
        <EmptyState Icon="🛡️" Title="还没有保险资料" Description="先录入一份保单，后续就能统一查看到期时间和联系人。" />
    }
    else
    {
        <div class="card-stack">
            @foreach (var record in _records)
            {
                <DocumentCard Title="@record.PolicyName"
                              Category="保险"
                              Subtitle="@record.ProviderName"
                              Description="@record.Summary"
                              Badge="@GetStatusLabel(record.Status)"
                              Href="@($"/documents/insurance/{record.Id}")"
                              Tags="@record.Tags"
                              MetaItems="@GetMeta(record)" />
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<InsuranceRecord> _records = [];
    private readonly IReadOnlyList<string> _filters = ["全部", "生效中", "待续保", "按家庭成员", "30 天内到期"];

    protected override async Task OnInitializedAsync()
    {
        _records = await DocumentCatalogService.GetInsuranceRecordsAsync();
    }

    private static string GetStatusLabel(InsuranceStatus status) => status switch
    {
        InsuranceStatus.Active => "生效中",
        InsuranceStatus.PendingRenewal => "待续保",
        InsuranceStatus.Expired => "已失效",
        _ => "已归档",
    };

    private static IReadOnlyList<string> GetMeta(InsuranceRecord record) =>
    [
        $"保障对象：{record.InsuredMemberId}",
        $"到期时间：{record.ExpiryDate:yyyy-MM-dd}",
        $"附件：{record.AttachmentCount} 份",
    ];
}
