@page "/documents/insurance"
@inject HomeHoney.Services.Documents.DocumentCatalogService DocumentCatalogService
@using HomeHoney.Models
@using HomeHoney.Components.Shared

<section class="content-page">
    <PageHeader Eyebrow="保险"
                Title="保险列表"
                Description="按状态、家庭成员和到期时间快速查看家庭保障现状。"
                BackHref="@AppRoutes.Documents"
                BackText="返回资料模块">
        <a class="button-primary" href="@AppRoutes.InsuranceNew">新增保险</a>
    </PageHeader>

    <FilterBar SearchPlaceholder="搜索保单名称、保障摘要、标签"
               Filters="_filters" />

    @if (!string.IsNullOrWhiteSpace(_state.Message))
    {
        <StatusBanner Title="@(_state.Status == CollectionViewStatus.Error ? "资料读取失败" : "资料同步提醒")"
                      Message="@_state.Message"
                      IsError="@(_state.Status == CollectionViewStatus.Error)"
                      IsLoading="@(_state.Status == CollectionViewStatus.Retrying)"
                      ActionText="@(_state.CanRetry ? "手动重试" : null)"
                      OnAction="ReloadAsync" />
    }

    @if (_state.Status == CollectionViewStatus.Loading || _state.Status == CollectionViewStatus.Retrying)
    {
        <EmptyState Icon="🛡️" Title="正在加载保险资料" Description="请稍候，系统正在尝试读取最新保单信息。" />
    }
    else if (_state.Items.Count == 0 && _state.Status != CollectionViewStatus.Error)
    {
        <EmptyState Icon="🛡️" Title="还没有保险资料" Description="先录入一份保单，后续就能统一查看到期时间和联系人。" ActionText="新增保险" ActionHref="@AppRoutes.InsuranceNew" />
    }
    else
    {
        <div class="card-stack">
            @foreach (var record in _state.Items)
            {
                <DocumentCard Title="@record.PolicyName"
                              Category="保险"
                              Subtitle="@record.ProviderName"
                              Description="@record.Summary"
                              Badge="@GetStatusLabel(record.Status)"
                              Href="@AppRoutes.InsuranceDetail(record.Id)"
                              Tags="@record.Tags"
                              MetaItems="@GetMeta(record)" />
            }
        </div>
    }
</section>

@code {
    private RetryableCollectionState<InsuranceRecord> _state = RetryableCollectionState<InsuranceRecord>.CreateLoading();
    private readonly IReadOnlyList<string> _filters = ["全部", "生效中", "待续保", "按家庭成员", "30 天内到期"];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private Task ReloadAsync() => LoadAsync(isRetry: true);

    private async Task LoadAsync(bool isRetry = false)
    {
        _state = isRetry
            ? RetryableCollectionState<InsuranceRecord>.CreateRetrying(_state.Items, _state.Message)
            : RetryableCollectionState<InsuranceRecord>.CreateLoading(_state.Items);

        var records = await DocumentCatalogService.GetInsuranceRecordsAsync();
        var message = DocumentCatalogService.LastErrorMessage;
        if (!string.IsNullOrWhiteSpace(message))
        {
            _state = RetryableCollectionState<InsuranceRecord>.CreateError(message, records, _state.LastSuccessAt);
            return;
        }

        _state = records.Count == 0
            ? RetryableCollectionState<InsuranceRecord>.CreateEmpty()
            : RetryableCollectionState<InsuranceRecord>.CreateReady(records);
    }

    private static string GetStatusLabel(InsuranceStatus status) => status switch
    {
        InsuranceStatus.Active => "生效中",
        InsuranceStatus.PendingRenewal => "待续保",
        InsuranceStatus.Expired => "已失效",
        _ => "已归档",
    };

    private static IReadOnlyList<string> GetMeta(InsuranceRecord record) =>
    [
        $"保障对象：{record.InsuredMemberId}",
        $"到期时间：{record.ExpiryDate:yyyy-MM-dd}",
        $"附件：{record.AttachmentCount} 份",
    ];
}
