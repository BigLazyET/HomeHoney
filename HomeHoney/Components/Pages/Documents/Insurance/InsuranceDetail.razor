@page "/documents/insurance/{Id:guid}"
@inject HomeHoney.Services.Documents.DocumentCatalogService DocumentCatalogService
@inject HomeHoney.Services.Storage.IAttachmentFilePicker AttachmentFilePicker
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using HomeHoney.Models
@using HomeHoney.Components.Shared
@using System.Diagnostics
@using System.IO

@if (_record is null)
{
    <EmptyState Icon="🛡️" Title="未找到保单" Description="这份保险资料可能已被移除，返回列表重新选择一条记录。" />
}
else
{
    <section class="content-page detail-page">
        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <StatusBanner Message="@_statusMessage" IsError="@_isStatusError" />
        }

        <PageHeader Eyebrow="保险详情"
                    Title="@PresentationFallbacks.TextOrFallback(_record.PolicyName, "未命名保单")"
                    Description="@PresentationFallbacks.TextOrFallback(_record.Summary, "暂未填写保单摘要。")"
                    BackHref="@AppRoutes.GetParentRoute(AppRoutes.InsuranceDetail(Id))"
                    BackText="返回保险列表">
            <button class="button-danger" type="button" @onclick="HandleDeleteAsync">删除资料</button>
            <a class="button-primary" href="@AppRoutes.InsuranceEdit(_record.Id)">编辑资料</a>
        </PageHeader>

        <div class="detail-grid">
            <article class="detail-card">
                <h2>保障信息</h2>
                <ul>
                    <li>保险公司：@PresentationFallbacks.TextOrFallback(_record.ProviderName)</li>
                    <li>保障对象：@DocumentCatalogService.GetMemberDisplayName(_record.InsuredMemberId)</li>
                    <li>保障类别：@GetCategory(_record.InsuranceCategory)</li>
                    <li>状态：@GetStatus(_record.Status)</li>
                    <li>生效时间：@PresentationFallbacks.DateOnlyOrFallback(_record.EffectiveDate)</li>
                    <li>到期时间：@PresentationFallbacks.DateOnlyOrFallback(_record.ExpiryDate)</li>
                </ul>
            </article>
            <article class="detail-card">
                <h2>联系人与附件</h2>
                <ul>
                    <li>联系人：@PresentationFallbacks.TextOrFallback(_record.ContactName)</li>
                    <li>联系电话：@PresentationFallbacks.TextOrFallback(_record.ContactPhone, "未填写联系电话")</li>
                    <li>附件数量：@_record.AttachmentCount</li>
                    <li>文件状态：@GetFileStatusLabel(_record.PrimaryFile)</li>
                    <li>标签：@PresentationFallbacks.TagsOrFallback(_record.Tags)</li>
                </ul>

                <div class="attachment-meta-list">
                    <div class="attachment-meta-item">
                        <span>文件名</span>
                        <strong>@GetAttachmentFileName(_record.PrimaryFile)</strong>
                    </div>
                    <div class="attachment-meta-item">
                        <span>文件大小</span>
                        <strong>@GetAttachmentFileSize(_record.PrimaryFile)</strong>
                    </div>
                    <div class="attachment-meta-item">
                        <span>最后同步</span>
                        <strong>@GetLastSyncedLabel(_record.PrimaryFile)</strong>
                    </div>
                </div>

                <div class="detail-actions">
                    <button class="button-secondary"
                            type="button"
                            @onclick="HandlePickFileAsync"
                            disabled="@_isUploading">
                        @(_selectedAttachment is null ? "选择附件" : $"已选择：{_selectedAttachment.FileName}")
                    </button>
                    <button class="button-primary"
                            type="button"
                            @onclick="HandleUploadAsync"
                            disabled="@_isUploading">
                        @(_isUploading ? "上传中..." : "上传附件")
                    </button>
                    <button class="button-secondary"
                            type="button"
                            @onclick="HandleDownloadAsync"
                            disabled="@(_record.PrimaryFile is null || _isDownloading)">
                        @(_isDownloading ? "下载中..." : "下载附件")
                    </button>
                </div>
            </article>
        </div>
    </section>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private InsuranceRecord? _record;
    private string? _statusMessage;
    private bool _isStatusError;
    private HomeHoney.Services.Storage.AttachmentFilePickResult? _selectedAttachment;
    private bool _isUploading;
    private bool _isDownloading;

    protected override async Task OnParametersSetAsync()
    {
        _record = await DocumentCatalogService.GetInsuranceRecordAsync(Id);
        _statusMessage = DocumentCatalogService.LastErrorMessage;
        _isStatusError = !string.IsNullOrWhiteSpace(_statusMessage);
    }

    private async Task HandleDeleteAsync()
    {
        if (_record is null)
        {
            return;
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"确认删除“{_record.PolicyName}”吗？删除后会从列表、首页摘要和搜索结果中移除。");
        if (!confirmed)
        {
            return;
        }

        _statusMessage = null;
        _isStatusError = false;
        await DocumentCatalogService.DeleteInsuranceRecordAsync(_record.Id);
        if (!string.IsNullOrWhiteSpace(DocumentCatalogService.LastErrorMessage))
        {
            _statusMessage = DocumentCatalogService.LastErrorMessage;
            _isStatusError = true;
            return;
        }

        NavigationManager.NavigateTo(AppRoutes.InsuranceList);
    }

    private async Task HandlePickFileAsync()
    {
        try
        {
            var picked = await AttachmentFilePicker.PickAsync();
            if (picked is null)
            {
                _statusMessage = "未获取到所选附件，请重试。如果你刚刚已经选中文件，但仍看到这条提示，请重新打开应用后再试一次。";
                _isStatusError = true;
                return;
            }

            _selectedAttachment = picked;
            _statusMessage = $"已选择附件“{picked.FileName}”（{PresentationFallbacks.FileSizeOrFallback(picked.SizeBytes, "大小未知")}），点击上传后会同步到后端。";
            _isStatusError = false;
        }
        catch (Exception ex)
        {
            _selectedAttachment = null;
            _statusMessage = ex is InvalidOperationException ? ex.Message : "打开附件选择器失败，请稍后重试。";
            _isStatusError = true;
            Debug.WriteLine($"InsuranceDetail.HandlePickFileAsync Error: {ex}");
        }
    }

    private async Task HandleUploadAsync()
    {
        if (_record is null || _selectedAttachment is null)
        {
            _statusMessage = "请先选择要上传的附件。";
            _isStatusError = true;
            return;
        }

        _isUploading = true;
        _statusMessage = null;
        _isStatusError = false;

        await using var stream = new MemoryStream(_selectedAttachment.Content, writable: false);
        var result = await DocumentCatalogService.UploadInsuranceFileAsync(_record.Id, stream, _selectedAttachment.FileName, _selectedAttachment.ContentType);

        _isUploading = false;
        if (!result.IsSuccess || !string.IsNullOrWhiteSpace(DocumentCatalogService.LastErrorMessage))
        {
            _statusMessage = DocumentCatalogService.LastErrorMessage ?? result.Message;
            _isStatusError = true;
            return;
        }

        _selectedAttachment = null;
        _record = await DocumentCatalogService.GetInsuranceRecordAsync(Id);
        _statusMessage = result.Message;
        _isStatusError = false;
    }

    private async Task HandleDownloadAsync()
    {
        if (_record is null || _record.PrimaryFile is null)
        {
            _statusMessage = "当前记录还没有可下载的附件。";
            _isStatusError = true;
            return;
        }

        _isDownloading = true;
        _statusMessage = null;
        _isStatusError = false;

        var result = await DocumentCatalogService.DownloadInsuranceFileAsync(_record.Id);
        _isDownloading = false;

        if (!result.IsSuccess || result.Content is null)
        {
            _statusMessage = DocumentCatalogService.LastErrorMessage ?? result.Message;
            _isStatusError = true;
            return;
        }

        await JSRuntime.InvokeVoidAsync(
            "homeHoneyDownloads.saveFile",
            result.FileName ?? _record.PrimaryFile.FileName,
            result.ContentType ?? _record.PrimaryFile.ContentType,
            Convert.ToBase64String(result.Content));

        _statusMessage = result.Message;
        _isStatusError = false;
    }

    private static string GetFileStatusLabel(FileResource? file)
        => file?.AvailabilityStatus switch
        {
            FileAvailabilityStatus.Available => "可下载",
            FileAvailabilityStatus.PendingUpload => "待上传",
            FileAvailabilityStatus.Missing => "文件缺失",
            FileAvailabilityStatus.SyncError => "同步失败",
            _ when file is null => "暂无附件",
            _ when string.IsNullOrWhiteSpace(file.FileName) => "附件信息待补充",
            _ => "同步状态未知",
        };

    private static string GetAttachmentFileName(FileResource? file)
        => file is null
            ? PresentationFallbacks.NotUploaded("PrimaryFile").DisplayText
            : PresentationFallbacks.TextOrFallback(file.FileName, "附件文件名未知");

    private static string GetAttachmentFileSize(FileResource? file)
        => file is null
            ? PresentationFallbacks.NotUploaded("PrimaryFile").DisplayText
            : PresentationFallbacks.FileSizeOrFallback(file.SizeBytes, "文件大小未知");

    private static string GetLastSyncedLabel(FileResource? file)
        => file is null
            ? PresentationFallbacks.NotUploaded("PrimaryFile").DisplayText
            : PresentationFallbacks.DateTimeOrFallback(file.LastSyncedAt, "尚未同步");

    private static string GetCategory(InsuranceCategory category) => category switch
    {
        InsuranceCategory.Medical => "医疗险",
        InsuranceCategory.CriticalIllness => "重疾险",
        InsuranceCategory.Accident => "意外险",
        InsuranceCategory.Life => "寿险",
        _ => "其他",
    };

    private static string GetStatus(InsuranceStatus status) => status switch
    {
        InsuranceStatus.Active => "生效中",
        InsuranceStatus.PendingRenewal => "待续保",
        InsuranceStatus.Expired => "已失效",
        _ => "已归档",
    };
}
