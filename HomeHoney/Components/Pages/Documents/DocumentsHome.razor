@page "/documents"
@inject HomeHoney.Services.Navigation.NavigationStructureService NavigationStructureService

<section class="content-page">
    <div class="section-heading">
        <div>
            <span class="page-eyebrow">资料模块</span>
            <h1>按资料类型进入</h1>
            <p>保险与说明书共用同一套浏览、详情和录入逻辑，先选你今天要处理的内容。</p>
        </div>
        <a class="button-primary" href="/documents/insurance/new">新增保险</a>
    </div>

    <div class="module-grid">
        @foreach (var item in NavigationStructureService.GetDocumentSections())
        {
            <a class="module-card" href="@item.Href">
                <span class="module-icon">@item.Icon</span>
                <div>
                    <h2>@item.Title</h2>
                    <p>@item.Description</p>
                </div>
            </a>
        }
    </div>
</section>
