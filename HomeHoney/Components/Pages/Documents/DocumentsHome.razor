@page "/documents"
@inject HomeHoney.Services.Navigation.NavigationStructureService NavigationStructureService

<section class="content-page">
    <div class="section-heading">
        <div>
            <span class="page-eyebrow">资料模块</span>
            <h1>按资料类型进入</h1>
            <p>保险与说明书共用同一套浏览、详情和录入逻辑，先选你今天要处理的内容；录入后还可以继续查看附件状态、同步时间和后续提醒。</p>
        </div>
        <div class="page-actions-inline">
            <a class="button-primary" href="@AppRoutes.InsuranceNew">新增保险</a>
            <a class="button-secondary" href="@AppRoutes.ManualNew">新增说明书</a>
        </div>
    </div>

    <div class="module-grid">
        @foreach (var item in NavigationStructureService.GetDocumentSections())
        {
            <a class="module-card" href="@item.Href">
                <span class="module-icon">@item.Icon</span>
                <div>
                    <h2>@item.Title</h2>
                    <p>@item.Description</p>
                </div>
            </a>
        }
    </div>
</section>
