@page "/reminders"
@inject HomeHoney.Services.Reminders.ReminderCenterService ReminderCenterService
@using HomeHoney.Models

<section class="content-page">
    <div class="section-heading">
        <div>
            <span class="page-eyebrow">提醒中心</span>
            <h1>未来 30 天需要关注的事项</h1>
            <p>集中查看保单到期、说明书保修、冰箱贴待办和正式备忘，避免遗漏。</p>
        </div>
        <a class="button-secondary" href="/search">进入全局搜索</a>
    </div>

    @if (_items.Count == 0)
    {
        <EmptyState Icon="⏰" Title="近期没有待处理提醒" Description="录入保险、说明书或家庭备忘后，这里会自动聚合未来 30 天的重要事项。" />
    }
    else
    {
        <div class="card-stack">
            @foreach (var item in _items)
            {
                <ReminderCard Title="@item.Title"
                              Summary="@item.Summary"
                              SourceLabel="@GetSource(item.SourceType)"
                              PriorityLabel="@GetPriority(item.Priority)"
                              PriorityClass="@item.Priority.ToString().ToLowerInvariant()"
                              DueAt="@item.DueAt"
                              Href="@item.Href" />
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<ReminderItem> _items = [];

    protected override async Task OnInitializedAsync()
    {
        _items = await ReminderCenterService.GetUpcomingAsync();
    }

    private static string GetSource(ReminderSourceType sourceType) => sourceType switch
    {
        ReminderSourceType.Insurance => "保险",
        ReminderSourceType.Manual => "说明书",
        ReminderSourceType.FridgeNote => "冰箱贴",
        _ => "备忘录",
    };

    private static string GetPriority(ReminderPriority priority) => priority switch
    {
        ReminderPriority.High => "高优先级",
        ReminderPriority.Medium => "中优先级",
        _ => "低优先级",
    };
}
