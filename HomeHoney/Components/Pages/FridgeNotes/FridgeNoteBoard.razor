@page "/fridge-notes"
@inject HomeHoney.Services.Collaboration.FamilyCollaborationService FamilyCollaborationService
@using HomeHoney.Models
@using HomeHoney.Components.Shared

<section class="content-page">
    <div class="section-heading">
        <div>
            <span class="page-eyebrow">家庭冰箱贴</span>
            <h1>快速提醒、购物和留言</h1>
            <p>适合记录高频、短文本、希望第一眼就看到的家庭事项。</p>
        </div>
        <a class="button-primary" href="@AppRoutes.FridgeNoteNew">新增冰箱贴</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <StatusBanner Message="@_statusMessage" IsError="false" />
    }

    @if (_notes.Count == 0)
    {
        <EmptyState Icon="🧲" Title="还没有冰箱贴" Description="删除旧内容后，可以继续写下购物事项、接送提醒或家庭留言，让首页也能快速看到。" />
    }
    else
    {
        <div class="sticky-board">
            @foreach (var note in _notes)
            {
                <a class="sticky-note sticky-note-@FamilyCollaborationService.GetNoteColorStyle(note)" href="@AppRoutes.FridgeNoteEdit(note.Id)">
                    <div class="sticky-note-top">
                        <span>@GetCategory(note.Category)</span>
                        <span>@GetPriority(note.Priority)</span>
                    </div>
                    <h3>@PresentationFallbacks.TextOrFallback(note.Title, "未命名冰箱贴")</h3>
                    <p>@PresentationFallbacks.TextOrFallback(note.Content, "这条冰箱贴还没有填写具体内容。")</p>
                    <div class="sticky-note-footer">
                        @if (note.DueAt is DateTime dueAt)
                        {
                            <span>@dueAt.ToString("MM-dd HH:mm")</span>
                        }
                        <span>@(note.IsPinned ? "📌 已置顶" : "点击编辑")</span>
                    </div>
                </a>
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<FridgeNote> _notes = [];
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        _notes = await FamilyCollaborationService.GetFridgeNotesAsync();
        _statusMessage = FamilyCollaborationService.LastErrorMessage;
    }

    private static string GetPriority(NotePriority priority) => priority switch
    {
        NotePriority.Urgent => "紧急",
        NotePriority.Important => "重要",
        _ => "普通",
    };

    private static string GetCategory(FridgeNoteCategory category) => category switch
    {
        FridgeNoteCategory.Shopping => "购物",
        FridgeNoteCategory.Reminder => "提醒",
        FridgeNoteCategory.Message => "留言",
        _ => "待办",
    };
}
