@inject HomeHoney.Services.Collaboration.FamilyCollaborationService FamilyCollaborationService

<section class="content-page">
    <div class="section-heading">
        <div>
            <span class="page-eyebrow">家庭备忘录</span>
            <h1>长期事项与正式记录</h1>
            <p>适合保存家规、采购计划、就医记录、教育提醒等需要长期维护的信息。</p>
        </div>
        <a class="button-primary" href="@AppRoutes.MemoNew">新增备忘录</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <StatusBanner Message="@_statusMessage" IsError="false" />
    }

    @if (_memos.Count == 0)
    {
        <EmptyState Icon="📝" Title="还没有备忘录" Description="把长期事项写下来，后续能继续跟进家庭规则、计划和重要安排。" ActionText="新增备忘录" ActionHref="@AppRoutes.MemoNew" />
    }
    else
    {
        <div class="memo-list">
            @foreach (var memo in _memos)
            {
                <a class="memo-list-item" href="@AppRoutes.MemoDetail(memo.Id)">
                    <div>
                        <div class="page-eyebrow">@GetCategoryLabel(memo.MemoCategory)</div>
                        <h3>@PresentationFallbacks.TextOrFallback(memo.Title, "未命名备忘录")</h3>
                        <p>@PresentationFallbacks.TextOrFallback(memo.Content, "这条备忘录暂时还没有填写详细内容。")</p>
                    </div>
                    <div class="memo-meta">
                        <span>@GetImportanceLabel(memo.Importance)</span>
                        <span>@GetStatusLabel(memo.Status)</span>
                        <span>@PresentationFallbacks.DateTimeOrFallback(memo.DueAt)</span>
                    </div>
                </a>
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<Memo> _memos = [];
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        _memos = await FamilyCollaborationService.GetMemosAsync();
        _statusMessage = FamilyCollaborationService.LastErrorMessage;
    }

    private static string GetCategoryLabel(MemoCategory category) => category switch
    {
        MemoCategory.FamilyRule => "家庭规则",
        MemoCategory.LongTermPlan => "长期计划",
        MemoCategory.ShoppingPlan => "采购计划",
        MemoCategory.Medical => "医疗事项",
        MemoCategory.Education => "教育安排",
        _ => "其他",
    };

    private static string GetImportanceLabel(MemoImportance importance) => importance switch
    {
        MemoImportance.Critical => "高优先级",
        MemoImportance.Important => "重要",
        _ => "普通",
    };

    private static string GetStatusLabel(MemoStatus status) => status switch
    {
        MemoStatus.InProgress => "进行中",
        MemoStatus.Completed => "已完成",
        _ => "已归档",
    };
}
