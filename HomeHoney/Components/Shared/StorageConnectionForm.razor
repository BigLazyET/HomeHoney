@using HomeHoney.Models

<EditForm Model="Model" OnValidSubmit="SubmitAsync">
    <div class="form-grid">
        <label class="form-grid-span-2">
            <span>后端 API 地址</span>
            <InputText @bind-Value="ApiBaseUrlProxy" @bind-Value:event="oninput" autocomplete="off" placeholder="留空时使用应用内安全默认地址" />
            <small>移动端不会显示内置默认地址；只有手动覆盖后才会展示当前值。</small>
        </label>
    </div>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="storage-status @(IsSuccess ? "is-success" : "is-error")">
            @StatusMessage
        </div>
    }

    <div class="page-actions">
        <button class="button-primary" type="submit">@PrimaryActionText</button>
    </div>
</EditForm>

@code {
    [Parameter]
    public StorageConnectionProfile Model { get; set; } = new();

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    [Parameter]
    public string PrimaryActionText { get; set; } = "保存并验证";

    [Parameter]
    public string? StatusMessage { get; set; }

    [Parameter]
    public bool IsSuccess { get; set; }

    private Task SubmitAsync() => OnSubmit.InvokeAsync();

    private string ApiBaseUrlProxy
    {
        get => string.Equals(Model.ApiBaseUrl, StorageConnectionProfile.DefaultBackendApiBaseUrl, StringComparison.OrdinalIgnoreCase)
            ? string.Empty
            : Model.ApiBaseUrl;
        set
        {
            Model.ApiBaseUrl = string.IsNullOrWhiteSpace(value)
                ? StorageConnectionProfile.DefaultBackendApiBaseUrl
                : value.Trim();
        }
    }
}
