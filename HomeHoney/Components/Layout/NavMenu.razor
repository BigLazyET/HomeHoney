@inject NavigationStructureService NavigationStructureService

<nav class="tab-bar">
    @foreach (var item in NavigationStructureService.GetPrimaryTabs())
    {
        if (item.MatchAll)
        {
            <NavLink class="tab-item" href="@item.Href" Match="NavLinkMatch.All">
                <span class="tab-icon">@item.Icon</span>
                <span class="tab-label">@item.Title</span>
            </NavLink>
        }
        else
        {
            <NavLink class="tab-item" href="@item.Href">
                <span class="tab-icon">@item.Icon</span>
                <span class="tab-label">@item.Title</span>
            </NavLink>
        }
    }
</nav>
