@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject UserPreferenceService UserPreferenceService

<div class="app-layout @ThemeClass @(IsWelcomeRoute ? "welcome-layout" : string.Empty)">
    <header class="app-header">
        <div>
            <div class="app-brand">HomeHoney</div>
            <div class="app-brand-subtitle">家庭资料与提醒中心</div>
        </div>
        @if (!IsWelcomeRoute)
        {
            <a class="app-header-link" href="@AppRoutes.Search">搜索</a>
        }
    </header>

    <main class="app-main">
        <article class="app-content @(IsNestedRoute ? "app-content-nested" : string.Empty)">
            @Body
        </article>
    </main>

    @if (!IsWelcomeRoute)
    {
        <NavMenu />
    }
</div>

@code {
    protected override void OnInitialized()
    {
        UserPreferenceService.Changed += HandleStateChanged;
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private bool IsWelcomeRoute => NavigationManager.ToBaseRelativePath(NavigationManager.Uri).StartsWith("welcome", StringComparison.OrdinalIgnoreCase);

    private bool IsNestedRoute
    {
        get
        {
            var route = AppRoutes.NormalizeRoute(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
            return route is not AppRoutes.Home and
                   not AppRoutes.Documents and
                   not AppRoutes.FridgeNotes and
                   not AppRoutes.Reminders and
                   not AppRoutes.Settings and
                   not AppRoutes.Welcome;
        }
    }

    private string ThemeClass => UserPreferenceService.GetPreferences().ThemeMode switch
    {
        ThemeMode.Dark => "theme-dark",
        ThemeMode.Light => "theme-light",
        _ => "theme-system",
    };

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        UserPreferenceService.Changed -= HandleStateChanged;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
